# Monitor arrangement.
output eDP-1 position 0,0
output HDMI-A-1 position 1366,0

# Wallpaper.
# Requires `archlinux-wallpaper` to be installed.
# NOTE: This command uses `swaybg` to set the wallpaper. Make sure its installed.
# `pacman -S swaybg`.
output * background ./wallpapers/arch_hero_wallpaper_by_rahremix.png fill

# Bar.
bar {
    swaybar_command waybar
}

# Window borders.
default_border none

# Gaps
gaps outer 5
gaps top 0
gaps inner 5
